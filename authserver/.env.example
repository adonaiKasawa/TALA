NODE_ENV=development
AUTH_PORT=4000
HOST=127.0.0.1
OIDC_ISSUER=http://localhost:4000
API_AUDIENCE=urn:tala:api
IDENTITY_AUDIENCE=urn:tala:identity
AUTH_ADMIN_CLIENT_IDS=tala-review
AUTH_APPLICATION_CLIENT_IDS=tala-web,tala-mobile
AUTH_WEB_ORIGIN=http://localhost:3000
AUTH_REVIEW_CLIENT_ID=tala-review
AUTH_ACCESS_TOKEN_TTL=300
AUTH_CODE_TTL=60
AUTH_REFRESH_ABSOLUTE_TTL=1209600
AUTH_REFRESH_IDLE_TTL=604800
AUTH_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/tala_authserver
AUTH_ENCRYPTION_KEY=GENERATE_64_HEX_CHARACTERS
AUTH_COOKIE_KEYS=GENERATE_AT_LEAST_43_RANDOM_CHARACTERS
AUTH_JWKS_PATH=.local/jwks.json
MAIL_FROM=identity@tala.example
# SMTP_URL=smtp://user:password@localhost:1025
# FEDERATION_PROVIDERS_PATH=.local/federation.json

# Clé commune avec l'API ; générée localement sans être affichée.
IDENTITY_SYNC_KEY=
SMS_DRIVER=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

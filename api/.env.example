API_PORT=4001
NODE_ENV=development
HOST=127.0.0.1
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/tala_db
OIDC_ISSUER=http://localhost:4000
API_AUDIENCE=urn:tala:api

# Vidéos locales : node ../scripts/setup-media.mjs depuis api, puis reconstruire.
MEDIA_ENABLED=false
MEDIA_DRIVER=local
MEDIA_QUEUE_DRIVER=postgres
MEDIA_ROOT=.local/media
MEDIA_ORIGIN=http://localhost:4001
MEDIA_SIGNING_KEY=GENERER_64_CARACTERES_HEXADECIMAUX
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_MAX_BYTES=536870912
MEDIA_DAILY_BYTES=2147483648
MEDIA_DAILY_UPLOADS=20
MEDIA_MAX_DURATION=3600
REDIS_URL=redis://127.0.0.1:6379
MEDIA_QUEUE=tala-media
# Renseigner en privé pour MEDIA_DRIVER=mux. Aucun secret dans Git.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY_PATH=.local/mux-signing.pem
MUX_TEST_ASSETS=true

# Clé commune avec AuthServer ; node scripts/setup-identity-sync.mjs depuis la racine.
IDENTITY_SYNC_KEY=

